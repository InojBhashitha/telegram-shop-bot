# =============================================================================
# Cloud Deals — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# --- Telegram Bot ---
BOT_TOKEN=

# --- Database ---
# SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./cloud_deals.db
# PostgreSQL (production / Neon):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?ssl=require

# --- Admin ---
# Comma-separated numeric Telegram user IDs that have admin access
ADMIN_TELEGRAM_IDS=

# --- Crypto Payment Provider ---
# Options: "cryptomus" or "nowpayments"
CRYPTO_PROVIDER=cryptomus

# Cryptomus Configuration
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_PAYMENT_KEY=

# NOWPayments Configuration (if using NOWPayments)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true

# --- Webhook ---
# Public HTTPS URL where the FastAPI server is accessible
# e.g., https://cloud-deals.onrender.com
WEBHOOK_BASE_URL=http://localhost:8000

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Store Settings ---
STORE_NAME=Cloud Deals
SUPPORT_USERNAME=
ORDER_EXPIRY_MINUTES=30

# --- Logging ---
LOG_LEVEL=INFO
