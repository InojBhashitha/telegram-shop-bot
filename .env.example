# =============================================================================
# Cloud Deals — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit your actual .env file to version control.
# =============================================================================

# --- Telegram Bot ---
# Bot token obtained from @BotFather on Telegram (Required)
BOT_TOKEN=

# --- Database ---
# SQLite (default for local development and self-hosting):
DATABASE_URL=sqlite+aiosqlite:///./cloud_deals.db
# PostgreSQL (production / Neon.tech / Supabase / Render):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?ssl=require

# --- Admin ---
# Comma-separated numeric Telegram user IDs that have admin access (e.g., from @userinfobot)
ADMIN_TELEGRAM_IDS=

# --- Crypto Payment Provider ---
# Options: "cryptomus", "nowpayments", or "binancepay"
CRYPTO_PROVIDER=cryptomus

# Cryptomus Configuration (if using Cryptomus)
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_PAYMENT_KEY=

# NOWPayments Configuration (if using NOWPayments)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true

# Binance Pay Configuration (if using Binance Pay) — 0% merchant fees!
# Get keys from: https://merchant.binance.com → Developers → API Keys
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=

# --- Webhook & Mini App ---
# Public HTTPS URL where the FastAPI server is accessible (Cloudflare Tunnel, Render, etc.)
# Required for Telegram Mini App and crypto payment IPN callbacks
# e.g., https://random-words-1234.trycloudflare.com or https://your-app.onrender.com
WEBHOOK_BASE_URL=http://localhost:8000

# Optional custom Mini App URL (defaults to WEBHOOK_BASE_URL + "/webapp" if left blank)
WEBAPP_URL=

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Store Settings ---
STORE_NAME=Cloud Deals
# Support username without @ (e.g. "CloudDealsSupport")
SUPPORT_USERNAME=
# Unpaid order expiry time in minutes (releases inventory automatically)
ORDER_EXPIRY_MINUTES=30
# Customer warranty replacement window in hours
WARRANTY_HOURS=24

# --- Channel & Marketing Features ---
# Official channel for force-subscribe / 10% welcome discount (e.g. "@YourChannel" or leave blank to disable)
FORCE_CHANNEL_ID=
# Channel where verified buyer reviews & vouches are automatically broadcast (e.g. "@YourVouches" or leave blank to disable)
VOUCH_CHANNEL_ID=

# --- Telegram Stars (XTR) ---
# USD value per Telegram Star (Default: 0.02, meaning 50 Stars = $1.00 USD)
STARS_USD_RATE=0.02

# --- Security & Vault Encryption ---
# 32-byte URL-safe base64 Fernet key for encrypting inventory credentials at rest
# (Leave empty to automatically derive a secure key from your BOT_TOKEN)
# Generate a standalone key via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INVENTORY_ENCRYPTION_KEY=

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
